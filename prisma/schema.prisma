// ============================================================
// PADARIA MUNICIPAL DE LUCAS DO RIO VERDE - MT
// Sistema de Planejamento de Produção Escolar
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // v8.6: trocado de "sqlite" para "postgresql" para deploy na Vercel + Supabase.
  // SQLite não funciona em serverless (filesystem efêmero da Vercel perde dados a cada cold start).
  // O schema Prisma é 100% compatível (apenas String/Int/Boolean/DateTime/Float — sem tipos Postgres-only).

  provider  = "postgresql"

  // url = usada pelo Prisma Client em runtime (queries da app).
  // Deve apontar para o TRANSACTION POOLER (porta 6543) — escala em serverless Vercel.
  // Adicionar ?pgbouncer=true&connection_limit=1 é CRÍTICO para Vercel + Supabase free tier.
  url       = env("DATABASE_URL")

  // directUrl = usada APENAS por prisma db push / prisma migrate (criação/alteração de schema).
  // Deve apontar para a DIRECT CONNECTION (porta 5432 do db.xxx.supabase.co).
  // Não pode ser pooler porque migrations precisam de sessão sticky.
  directUrl = env("DIRECT_URL")
}

// ── Autenticação (NextAuth) ─────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String    // hashed with bcryptjs
  role          String    @default("user") // admin, user, nutricionista
  ativo         Boolean   @default(true)
  createdAt     String    @default("")

  accounts      Account[]
  sessions      Session[]
  nutricionista Nutricionista?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    String

  @@unique([identifier, token])
}

// ── Escolas ──────────────────────────────────────────────────
model Escola {
  id            String   @id @default(cuid())
  nome          String
  nome_curto    String
  categoria     String   // REGULAR, INTEGRAL, BIFASICA, CRECHE, INTERIOR, OUTROS
  rota          String   // JOSE, AROLDO, BUSCA_PROPRIA
  busca_propria Boolean  @default(false)
  recebe_pf     Boolean  @default(true)
  recebe_pcq    Boolean  @default(true)
  recebe_lanche Boolean  @default(true)
  ativo         Boolean  @default(true)
  ordem_rota    Int      @default(0)
  obs           String?

  // ── NOVOS CAMPOS: lista de compras / cardápio ──
  segmento        String  @default("REGULAR")  // CRECHE, PRE_ESCOLA, FUND_INICIAL, FUND_FINAL, REGULAR, INTEGRAL
  alunos_parcial  Int     @default(0)  // alunos com 1 refeição/dia (regular)
  alunos_integral Int     @default(0)  // alunos com 2 refeições/dia (integral)
  dia_pao_frances String? // SEG, TER, QUA, QUI, SEX — dia fixo de pão francês (null = não recebe)
  dia_lanche      String? // SEG, TER, QUA, QUI, SEX — dia fixo de lanche especial (null = não recebe)
  // v9.5.5: escala de impressão (zoom) por cardápio (70-150, default 100)
  // Permite ao usuário ajustar o zoom da impressão sem usar Microsoft Print to PDF.
  escala_impressao  Int     @default(100)
  // Indica se a escola mescla alunos regular + integral numa mesma refeição (afeta percapita)
  mescla_parcial_integral Boolean @default(false)

  // v9.5: Órgãos fixos — produzem pão TODA semana independente do cardápio escolar
  // true = sempre produz PF (ignora tipo_pao do cardápio semestral)
  pao_fixo Boolean @default(false)

  pf_quantidades    PfQuantidade[]
  pcq_quantidades   PcqQuantidade[]
  lanche_distribuicao LancheDistribuicao[]
  ajustes           Ajuste[]
  cardapio_nutricional CardapioNutricional[]

  @@index([categoria])
  @@index([rota])
  @@index([ativo])
  @@index([segmento])
}

// ── PF (Pão Francês) Quantidades por escola/tipo ────────────
model PfQuantidade {
  id         String  @id @default(cuid())
  escola_id  String
  tipo_pao   String  // PADRAO, PROTEINA, SEMPAO
  segunda    Int     @default(0)
  terca      Int     @default(0)
  quarta     Int     @default(0)
  quinta     Int     @default(0)
  sexta      Int     @default(0)

  escola Escola @relation(fields: [escola_id], references: [id], onDelete: Cascade)

  @@unique([escola_id, tipo_pao])
}

// ── PCQ (Pão de Cachorro Quente) Quantidades ────────────────
model PcqQuantidade {
  id              String  @id @default(cuid())
  escola_id       String
  prod_segunda    Float   @default(0)
  prod_quarta     Float   @default(0)
  prod_sexta      Float   @default(0)
  pf_comp_segunda Float   @default(0)
  pf_comp_quarta  Float   @default(0)
  pf_comp_sexta   Float   @default(0)

  escola Escola @relation(fields: [escola_id], references: [id], onDelete: Cascade)

  @@unique([escola_id])
}

// ── Lanches ──────────────────────────────────────────────────
model Lanche {
  id      String  @id @default(cuid())
  nome    String
  unidade String  @default("un")
  ativo   Boolean @default(true)
  obs     String?

  distribuicao      LancheDistribuicao[]
  cardapio_regular  CardapioSemestral[] @relation("CardapioRegular")
  cardapio_bifasica CardapioSemestral[] @relation("CardapioBifasica")
}

// ── Lanche Distribuição (escola × dia × quantidade) ─────────
model LancheDistribuicao {
  id         String  @id @default(cuid())
  lanche_id  String
  escola_id  String
  dia_semana String  // segunda, terca, quarta, quinta, sexta
  quantidade Int     @default(0)
  obs        String?

  lanche Lanche @relation(fields: [lanche_id], references: [id], onDelete: Cascade)
  escola Escola @relation(fields: [escola_id], references: [id], onDelete: Cascade)

  @@unique([lanche_id, escola_id, dia_semana])
}

// ── Cardápio Semestral (22 semanas) ─────────────────────────
model CardapioSemestral {
  id                 String  @id @default(cuid())
  ano                Int
  semana             Int     // número da semana letiva (1-22)
  numero_semana_iso  Int     // semana ISO do calendário
  data_inicio        String  // YYYY-MM-DD
  data_fim           String  // YYYY-MM-DD
  tipo_pao           String  @default("PADRAO") // PADRAO, PROTEINA, SEMPAO
  nome_pao           String  @default("Pão Francês")
  lanche_regular_id  String?
  lanche_bifasica_id String?
  obs                String?

  lanche_regular  Lanche? @relation("CardapioRegular", fields: [lanche_regular_id], references: [id], onDelete: SetNull)
  lanche_bifasica Lanche? @relation("CardapioBifasica", fields: [lanche_bifasica_id], references: [id], onDelete: SetNull)

  @@unique([ano, semana])
}

// ── Feriados ─────────────────────────────────────────────────
model Feriado {
  id                String  @id @default(cuid())
  data              String  // YYYY-MM-DD
  nome              String
  tipo              String  @default("NACIONAL") // NACIONAL, ESTADUAL, MUNICIPAL, ESCOLAR
  escolas_afetadas  String  @default("TODAS") // TODAS, REGULARES, INTEGRAIS, CRECHES, BIFASICA, INTERIOR, OUTROS
  acao              String  @default("zerar_dia") // zerar_dia, zerar_pf, zerar_pcq, zerar_lanche, apenas_observacao
  obs               String?

  @@unique([data, escolas_afetadas])
}

// ── Ajustes Semanais ─────────────────────────────────────────
model Ajuste {
  id           String  @id @default(cuid())
  ano          Int
  semana       Int
  escola_id    String
  dia_semana   String  // segunda, terca, quarta, quinta, sexta
  produto      String  // PF, PCQ, LANCHE, PF_COMP
  qtd_original Int     @default(0)
  ajuste       Int     @default(0) // delta (+/-)
  qtd_final   Int     @default(0)
  motivo       String?

  escola Escola @relation(fields: [escola_id], references: [id], onDelete: Cascade)

  @@unique([ano, semana, escola_id, dia_semana, produto])
}

// ── Produção Extra (instituições avulsas) ──────────────────
model ProducaoExtra {
  id               String   @id @default(cuid())
  ano              Int
  semana           Int      // semana ISO do calendário
  nome_instituicao String
  produto          String   // 'PF' | 'PCQ' | 'LANCHE'
  dia_semana       String   // segunda, terca, quarta, quinta, sexta
  quantidade       Int      @default(0)
  observacao       String?
  criado_em        DateTime @default(now())

  @@index([ano, semana])
}

// ── Histórico de Semanas (snapshot) ──────────────────────────
model HistoricoSemana {
  id              String  @id @default(cuid())
  ano             Int
  semana          Int
  data_inicio     String  // YYYY-MM-DD
  data_fim        String  // YYYY-MM-DD
  tipo_pao        String
  nome_pao        String
  lanche_regular  String? // nome do lanche
  lanche_bifasica String?
  total_pf        Int     @default(0)
  total_pcq       Int     @default(0)
  total_lanche    Int     @default(0)
  ajustes_count   Int     @default(0)
  gerado_por      String  @default("Sistema")
  gerado_em       String  // YYYY-MM-DD HH:mm
  snapshot_json   String  // JSON completo

  @@unique([ano, semana])
}

// ── Insumos ──────────────────────────────────────────────────
model Insumo {
  id             String   @id @default(cuid())
  nome           String
  unidade        String   @default("kg")
  preco_unitario Float    @default(0)
  estoque_atual  Float    @default(0)
  estoque_minimo Float    @default(0)
  fornecedor     String?
  ativo          Boolean  @default(true)

  receitas        Receita[]
  movimentacoes   MovimentacaoEstoque[]
  pedidos_itens   ItemPedidoCompra[]
  contagens       ContagemEstoque[]
}

// ── Receitas (composição por unidade de produto) ─────────────
model Receita {
  id                   String  @id @default(cuid())
  produto_tipo         String  // PF, PCQ, LANCHE
  insumo_id            String
  quantidade_por_unidade Float  @default(0) // qtd de insumo por unidade de produto

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@unique([produto_tipo, insumo_id])
}

// ── Movimentações de Estoque ─────────────────────────────────
model MovimentacaoEstoque {
  id            String  @id @default(cuid())
  insumo_id     String
  tipo          String  // ENTRADA, SAIDA
  quantidade    Float   @default(0)
  preco_unitario Float  @default(0)
  preco_total   Float   @default(0)
  data          String  // YYYY-MM-DD
  obs           String?

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)
}

// ── Pedidos de Compra ─────────────────────────────────────────
model PedidoCompra {
  id            String   @id @default(cuid())
  fornecedor    String
  data_pedido   String   // YYYY-MM-DD
  data_prevista String?  // YYYY-MM-DD
  status        String   @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, RECEBIDO, CANCELADO
  obs           String?
  criado_em     String   @default("now()")

  itens         ItemPedidoCompra[]

  @@map("pedidos_compra")
}

// ── Itens do Pedido de Compra ─────────────────────────────────
model ItemPedidoCompra {
  id              String   @id @default(cuid())
  pedido_id       String
  insumo_id       String
  quantidade      Float   @default(0)
  preco_unitario  Float   @default(0)
  preco_total     Float   @default(0)
  recebido        Boolean @default(false)

  pedido  PedidoCompra @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  insumo  Insumo       @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@map("itens_pedido_compra")
}

// ── Contagem Física de Estoque ──────────────────────────────
model ContagemEstoque {
  id              String   @id @default(cuid())
  data_contagem   String   // YYYY-MM-DD
  insumo_id       String
  quantidade      Float    // physical count quantity
  estoque_sistema Float    @default(0) // system stock at time of count (snapshot)
  diferenca       Float    @default(0) // estoque_sistema - quantidade
  obs             String?
  criado_em       String   @default("") // YYYY-MM-DD HH:mm

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@index([data_contagem])
  @@index([insumo_id])
}

// ══════════════════════════════════════════════════════════════
//  MÓDULO DE NUTRIÇÃO — Cardápio Nutricional PNAE
// ══════════════════════════════════════════════════════════════

// ── Nutricionista ───────────────────────────────────────────
model Nutricionista {
  id        String  @id @default(cuid())
  user_id   String? @unique   // opcional — nutricionista pode ser cadastrado sem login
  nome      String
  crn       String  // CRN (ex: "CRN-3 12345")
  ativo     Boolean @default(true)

  user      User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cardapios CardapioNutricional[]

  @@index([crn])
}

// ── Tipo de Refeição ────────────────────────────────────────
model TipoRefeicao {
  id       String  @id @default(cuid())
  codigo   String  @unique // CAFE_MANHA, FRUTA_MANHA, ALMOCO, LANCHE, HIDRATACAO, JANTAR, LANCHE_1, LANCHE_2, LANCHE_PRE_ESCOLA
  nome     String  // "Café da Manhã"
  horario  String  // "07h30min"
  ordem    Int     @default(0)

  // v8.13: Se preenchido, este slot é renderizado como SUB de outro slot
  // (ex: FRUTA_MANHA é sub de CAFE_MANHA — mesma caixa visual, sem linha separada no PDF)
  // O campo armazena o CÓDIGO do tipo pai (não o ID) para facilitar migrações.
  sub_de_codigo String?

  categoria_refeicoes CategoriaRefeicao[]
  cardapio_itens      CardapioItem[]
  metas               MetaNutricional[]
  sobrescritas        SobrescritaCardapio[]
  // v8.7: horários customizados por cardápio (override do default desta refeição)
  horarios_cardapios  CardapioHorarioRefeicao[]
}

// ── Categoria de Escola × Refeição ──────────────────────────
model CategoriaRefeicao {
  id                 String  @id @default(cuid())
  categoria_escola   String  // REGULAR, INTEGRAL, BIFASICA, CRECHE, INTERIOR
  tipo_refeicao_id   String
  percentual_energia Float   @default(0) // % de energia diária para esta refeição

  tipo_refeicao      TipoRefeicao @relation(fields: [tipo_refeicao_id], references: [id], onDelete: Cascade)

  @@unique([categoria_escola, tipo_refeicao_id])
  @@index([categoria_escola])
}

// ── Alimento (Base TACO) ───────────────────────────────────
model Alimento {
  id                  String  @id @default(cuid())
  codigo_taco         Int?
  nome                String
  grupo               String  // Cereais e derivados, Leguminosas, Verduras, Frutas, Carnes, Leite e derivados, etc.
  medida_caseira      String  // "1 colher de sopa", "1 unidade média"
  gramas_por_medida   Float   @default(0)

  // Valores nutricionais por 100g
  energia_kcal        Float   @default(0)
  carboidratos_g      Float   @default(0)
  proteinas_g         Float   @default(0)
  lipidios_g          Float   @default(0)
  fibra_alimentar_g   Float   @default(0)
  sodio_mg            Float   @default(0)
  ferro_mg            Float   @default(0)
  ferro_heme_mg       Float   @default(0)
  vitamina_a_mcg      Float   @default(0)
  vitamina_c_mg       Float   @default(0)
  calcio_mg           Float   @default(0)
  magnesio_mg         Float   @default(0)
  zinco_mg            Float   @default(0)
  acucar_adicionado_g Float   @default(0)

  ativo               Boolean @default(true)

  ingredientes        PreparacaoIngrediente[]

  @@index([nome])
  @@index([grupo])
  @@index([ativo])
}

// ── Preparação (Receita do Nutricionista) ───────────────────
model Preparacao {
  id           String  @id @default(cuid())
  nome         String
  descricao    String?
  modo_preparo String?
  ativo        Boolean @default(true)

  // ── NOVOS: biblioteca inteligente ──
  favorita     Boolean @default(false)  // marcada como favorita pela nutricionista
  vezes_usada  Int     @default(0)      // contador automático: quantas vezes entrou em cardápios
  // Tags opcionais para busca avançada (ex.: "vegetariano", "sem_gluten", "alto_ferro")
  tags         String  @default("")

  // ── v8: categoria da preparação (define tratamento especial na replicação) ──
  // PREPARACAO = prato normal (default)
  // PAO        = pão francês / pão de forma (recebe dia fixo na replicação)
  // LANCHE     = lanche especial (recebe dia fixo na replicação)
  // BEBIDA     = bebida (suco, leite, chá)
  // SOBREMESA  = sobremesa
  categoria    String  @default("PREPARACAO")

  ingredientes   PreparacaoIngrediente[]
  cardapio_itens CardapioItem[]

  // Substituições equivalentes (relação N:N)
  substituicoes_origem    PreparacaoSubstituicao[] @relation("Subst_Origem")
  substituicoes_destino   PreparacaoSubstituicao[] @relation("Subst_Destino")
  // Sobrescritas de cardápio que apontam para esta preparação como substituta
  sobrescritas_como_substituta SobrescritaCardapio[]

  @@index([nome])
  @@index([favorita])
  @@index([vezes_usada])
}

// ── Ingrediente da Preparação ───────────────────────────────
model PreparacaoIngrediente {
  id                  String  @id @default(cuid())
  preparacao_id       String
  alimento_id         String
  quantidade_gramas   Float   @default(0) // percapita base (Ens. Fund. Final = 100%)
  mesma_percapita     Boolean @default(false) // se true, mesma qtd para todas as fases (ex: fruta)

  preparacao          Preparacao @relation(fields: [preparacao_id], references: [id], onDelete: Cascade)
  alimento            Alimento   @relation(fields: [alimento_id], references: [id], onDelete: Cascade)

  percapitas          PreparacaoPercapita[]

  @@unique([preparacao_id, alimento_id])
}

// ── Percapita por Fase Escolar ──────────────────────────────
model PreparacaoPercapita {
  id                  String  @id @default(cuid())
  ingrediente_id      String  // FK para PreparacaoIngrediente
  fase_escolar        String  // BERCARIO, CRECHE, ED_INFANTIL, FUND_INICIAL, FUND_FINAL
  quantidade_gramas   Float   @default(0) // percapita em gramas para esta fase
  auto_calculado      Boolean @default(true) // se true, foi calculado pelo percentual padrão

  ingrediente         PreparacaoIngrediente @relation(fields: [ingrediente_id], references: [id], onDelete: Cascade)

  @@unique([ingrediente_id, fase_escolar])
  @@index([fase_escolar])
}

// ── Cardápio Nutricional (semestre) ─────────────────────────
model CardapioNutricional {
  id               String  @id @default(cuid())
  nome             String  // "Cardápio Regular 2025/1"
  escola_id        String? // null = modelo base, preenchido = escola específica
  nutricionista_id String
  categoria_escola String  // REGULAR, INTEGRAL, BIFASICA, CRECHE, INTERIOR
  fase_escolar     String  @default("FUND_FINAL") // BERCARIO, CRECHE, ED_INFANTIL, FUND_INICIAL, FUND_FINAL
  ano              Int
  semestre         Int     @default(1) // 1 ou 2
  status           String  @default("RASCUNHO") // RASCUNHO, APROVADO
  origem_id        String? // ID do cardápio que foi clonado
  criado_em        String  @default("")
  atualizado_em    String  @default("")

  // ── NOVOS: cardápio base × instância × ciclo PNAE ──
  // Se preenchido, este cardápio é uma INSTÂNCIA do base.
  // Permite que mudanças no base se propaguem, mas com sobrescritas por escola.
  cardapio_base_id String?
  // Ciclo PNAE: nº de semanas únicas (default 5). Semana X do semestre mapeia para ((X-1) % ciclo) + 1
  ciclo_semanas    Int     @default(5)
  // Se true, semanas além do ciclo são geradas como cópia automática da semana correspondente
  repetir_ciclo    Boolean @default(true)

  // ── v8: dia fixo de pão e lanche (override por cardápio) ──
  // Quando o cardápio é replicado de um base, esses campos guardam em qual dia
  // da semana a escola recebe pão e lanche (SEG, TER, QUA, QUI, SEX).
  // null = não recebe / não aplicável para este cardápio.
  dia_pao_frances   String?  // SEG | TER | QUA | QUI | SEX | null
  dia_lanche        String?  // SEG | TER | QUA | QUI | SEX | null
  // v9.5.5: escala de impressão (zoom) por cardápio (70-150, default 100)
  // Permite ao usuário ajustar o zoom da impressão sem usar Microsoft Print to PDF.
  escala_impressao  Int     @default(100)

  escola            Escola?        @relation(fields: [escola_id], references: [id], onDelete: SetNull)
  nutricionista     Nutricionista  @relation(fields: [nutricionista_id], references: [id])
  semanas           CardapioSemanaNutri[]
  sobrescritas      SobrescritaCardapio[]
  listas_compras    ListaCompras[]
  // v8.7: horários customizados por tipo de refeição (override do default)
  horarios_refeicoes CardapioHorarioRefeicao[]

  @@index([escola_id])
  @@index([categoria_escola])
  @@index([status])
  @@index([ano, semestre])
  @@index([cardapio_base_id])
}

// ── Semana do Cardápio Nutricional ──────────────────────────
model CardapioSemanaNutri {
  id           String  @id @default(cuid())
  cardapio_id  String
  numero       Int     // 1-22
  data_inicio  String  // YYYY-MM-DD
  data_fim     String  // YYYY-MM-DD

  // ── v8: marca semanas que foram modificadas vs base após replicação ──
  // false = semana é cópia fiel do base (default após replicar)
  // true  = semana foi diferenciada/editada (badge "Modificada" no editor)
  diferenciada  Boolean @default(false)

  cardapio     CardapioNutricional @relation(fields: [cardapio_id], references: [id], onDelete: Cascade)
  dias         CardapioDiaNutri[]

  @@unique([cardapio_id, numero])
  @@index([cardapio_id])
}

// ── Dia do Cardápio Nutricional ─────────────────────────────
model CardapioDiaNutri {
  id          String  @id @default(cuid())
  semana_id   String
  dia_semana  String  // segunda, terca, quarta, quinta, sexta

  semana      CardapioSemanaNutri @relation(fields: [semana_id], references: [id], onDelete: Cascade)
  itens       CardapioItem[]

  @@unique([semana_id, dia_semana])
  @@index([semana_id])
}

// ── Item do Cardápio (refeição × preparação) ───────────────
model CardapioItem {
  id                String  @id @default(cuid())
  dia_id            String
  tipo_refeicao_id  String
  preparacao_id     String
  porcoes           Int     @default(1)
  ordem             Int     @default(0)  // v8: ordem de exibição dentro do slot (0 = auto-sort)

  dia               CardapioDiaNutri @relation(fields: [dia_id], references: [id], onDelete: Cascade)
  tipo_refeicao     TipoRefeicao     @relation(fields: [tipo_refeicao_id], references: [id])
  preparacao        Preparacao       @relation(fields: [preparacao_id], references: [id])

  @@unique([dia_id, tipo_refeicao_id, preparacao_id])
  @@index([dia_id])
  @@index([tipo_refeicao_id])
}

// ── Meta Nutricional PNAE ──────────────────────────────────
model MetaNutricional {
  id                     String  @id @default(cuid())
  tipo_refeicao_id       String
  categoria_escola       String
  energia_kcal_min       Float   @default(0)
  energia_kcal_max       Float   @default(0)
  carboidratos_pct_min   Float   @default(0)
  carboidratos_pct_max   Float   @default(0)
  proteinas_pct_min      Float   @default(0)
  proteinas_pct_max      Float   @default(0)
  lipidios_pct_min       Float   @default(0)
  lipidios_pct_max       Float   @default(0)
  sodio_mg_max           Float   @default(0)
  ferro_mg_min           Float   @default(0)
  ferro_heme_dias_semana Int     @default(4)
  vitamina_a_mcg_min     Float   @default(0)
  vitamina_a_dias_semana Int     @default(3)
  vitamina_c_mg_min      Float   @default(0)
  acucar_pct_max         Float   @default(7)
  acucar_proibido_menor3 Boolean @default(true)

  tipo_refeicao         TipoRefeicao @relation(fields: [tipo_refeicao_id], references: [id])

  @@unique([tipo_refeicao_id, categoria_escola])
}

// ══════════════════════════════════════════════════════════════
//  EXTENSÕES v6 — Sistema de Cardápio-Base × Instância por Escola
//                  + Biblioteca de Preparações + Lista de Compras
// ══════════════════════════════════════════════════════════════

// ── Sobrescrita de Cardápio por Escola ─────────────────────
// Permite que uma escola específica altere UMA preparação
// do cardápio base (ex.: trocar pão de quarta → terça)
// sem precisar criar um cardápio completo separado.
model SobrescritaCardapio {
  id                       String  @id @default(cuid())
  cardapio_id              String   // FK para CardapioNutricional (instância escola)
  semana_numero            Int      // 1-22 — qual semana do semestre
  dia_semana               String   // SEG, TER, QUA, QUI, SEX
  tipo_refeicao_id         String   // qual refeição
  preparacao_substituta_id String   // FK para Preparacao
  motivo                   String?  // ex.: "Padaria não produz pão nesta data"
  criado_em                String   @default("")

  cardapio             CardapioNutricional @relation(fields: [cardapio_id], references: [id], onDelete: Cascade)
  tipo_refeicao        TipoRefeicao        @relation(fields: [tipo_refeicao_id], references: [id])
  preparacao_substituta Preparacao         @relation(fields: [preparacao_substituta_id], references: [id])

  @@unique([cardapio_id, semana_numero, dia_semana, tipo_refeicao_id])
  @@index([cardapio_id])
}

// ── Substituição Equivalente de Preparações ────────────────
// Relação N:N entre preparações equivalentes nutricionalmente
// (ex.: "Coxa de Frango" ↔ "Sobrecoxa" ↔ "Peito de Frango")
model PreparacaoSubstituicao {
  id                  String  @id @default(cuid())
  preparacao_origem_id String
  preparacao_destino_id String
  motivo              String  @default("MESMO_GRUPO") // MESMO_GRUPO, MESMO_PERFIL_NUTRICIONAL, ALTERNATIVA_DIET
  criado_em           String  @default("")

  preparacao_origem   Preparacao @relation("Subst_Origem",  fields: [preparacao_origem_id],  references: [id], onDelete: Cascade)
  preparacao_destino  Preparacao @relation("Subst_Destino", fields: [preparacao_destino_id], references: [id], onDelete: Cascade)

  @@unique([preparacao_origem_id, preparacao_destino_id])
  @@index([preparacao_origem_id])
}

// ── Snapshot de Lista de Compras ───────────────────────────
// Gerada a partir de um cardápio + conjunto de escolas.
// Cada item consolida ingrediente × quantidade total × unidade.
model ListaCompras {
  id              String  @id @default(cuid())
  nome            String  // "Lista Compras 2025/1 — Semana 1-4"
  cardapio_id     String
  gerada_em       String  @default("")
  // JSON com as escolas + alunos considerados no cálculo (snapshot)
  escolas_snapshot String @default("[]")
  // JSON com itens consolidados: [{alimento_id, nome, unidade, qtd_total, qtd_por_escola: [{escola, qtd}]}]
  itens_json      String  @default("[]")
  status          String  @default("GERADA")  // GERADA, ENVIADA, RECEBIDA

  cardapio        CardapioNutricional @relation(fields: [cardapio_id], references: [id], onDelete: Cascade)

  @@index([cardapio_id])
  @@index([gerada_em])
}

// ── Relação extra: CardapioNutricional ↔ ListaCompras ──────
// (Adicionada via back-relation; Prisma exige declaração explícita)
// Para evitar conflito de schema, adicionamos a relação ao
// CardapioNutricional abaixo como lista_compras.

// ── v8.7: Horário customizado de refeição por cardápio ─────
// Permite que cada cardápio tenha seu próprio horário para cada tipo
// de refeição, sobrescrevendo o default de TipoRefeicao.horario.
//
// Casos de uso:
//   - Lanche da Regular servido em 2 horários: "09h00 / 15h00"
//   - Almoço do Interior às 11h00 (em vez de 10h00 default)
//   - Renomear "Lanche" para "Lanche (manhã/tarde)" sem alterar tabela global
//
// Quando não existe registro, o sistema usa TipoRefeicao.horario (default).
model CardapioHorarioRefeicao {
  id                String  @id @default(cuid())
  cardapio_id       String
  tipo_refeicao_id  String
  horario           String  // ex: "09h00 / 15h00" ou "11h00min"
  // Número de vezes que esta refeição é servida no dia (default 1).
  // Se horario="09h00 / 15h00", multiplicador=2 (mas a preparação aparece 1x só).
  multiplicador     Int     @default(1)

  cardapio       CardapioNutricional @relation(fields: [cardapio_id], references: [id], onDelete: Cascade)
  tipo_refeicao  TipoRefeicao        @relation(fields: [tipo_refeicao_id], references: [id], onDelete: Cascade)

  @@unique([cardapio_id, tipo_refeicao_id])
  @@index([cardapio_id])
}
