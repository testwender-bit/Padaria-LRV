{
  "name": "padaria-municipal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed": "npx prisma db seed",
    "seed:taco": "npx tsx prisma/seed-taco-alimentos.ts",
    "seed:nutricao": "npx tsx prisma/seed-nutricao.ts",
    "seed:all": "npx prisma db seed && npx tsx prisma/seed-taco-alimentos.ts && npx tsx prisma/seed-nutricao.ts",
    "seed:users": "npx tsx prisma/seed-users.ts",
    "export:sqlite": "npx tsx scripts/export-sqlite-to-json.ts",
    "import:supabase": "npx tsx scripts/import-json-to-supabase.ts"
  },
  "dependencies": {
